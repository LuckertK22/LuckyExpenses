# Copia este archivo a `.env` y completa los valores antes de levantar el stack.
# El archivo `.env` NO se commitea (está en .gitignore).

# Password de la base de datos PostgreSQL
POSTGRES_PASSWORD=postgres

# Clave secreta del JWT (minimo 32 bytes / 256 bits para HS256).
# Genera una nueva con: openssl rand -base64 48
JWT_KEY=change-me-with-a-random-32-byte-key
